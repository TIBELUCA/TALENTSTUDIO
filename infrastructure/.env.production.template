# =============================================================================
# QuotePilot — Production Environment Variables
# =============================================================================
# Copy this file to /opt/quotepilot/.env and fill in the values.
# NEVER commit the filled .env file to version control.
# =============================================================================

# ─── DATABASE ────────────────────────────────────────────────────────────────
# Cloud SQL private IP connection string (from gcp-setup.sh output)
DATABASE_URL=postgresql://quotepilot:YOUR_SQL_PASSWORD@CLOUD_SQL_PRIVATE_IP:5432/quotepilot

# ─── SESSION & SECURITY ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Encryption key for OAuth tokens stored in DB (32+ chars)
# Generate with: openssl rand -hex 32
EMAIL_TOKEN_ENCRYPTION_KEY=

# ─── AI ──────────────────────────────────────────────────────────────────────
# OpenAI API key for AI assistant features
OPENAI_API_KEY=

# AI provider (default: openai)
# AI_PROVIDER=openai

# AI model (default: gpt-4o-mini)
# AI_MODEL=gpt-4o-mini

# ─── GOOGLE OAUTH (Gmail integration) ───────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── MICROSOFT OAUTH (Outlook integration, optional) ────────────────────────
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ─── BANKING (TrueLayer integration, optional) ──────────────────────────────
# TRUELAYER_CLIENT_ID=
# TRUELAYER_CLIENT_SECRET=

# ─── WEBHOOKS (optional) ────────────────────────────────────────────────────
# WEBHOOKS_ENABLED=false
# WEBHOOK_ENDPOINTS=https://your-webhook-url.com/hook

# ─── APPLICATION ─────────────────────────────────────────────────────────────
# These are set automatically in docker-compose.prod.yml
# NODE_ENV=production
# PORT=5000
# COOKIE_SECURE=true
